{
  "name": "realm-rampage",
  "version": "1.0.0",
  "private": true,
  "description": "幻域无双 · Realm Rampage —— 3D 奇幻无双割草肉鸽（Three.js + Vite）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:ui": "npm run build && playwright test",
    "check": "node scripts/check.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "models:build": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python scripts/blender/build.py -- --export",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "7.3.6"
  },
  "engines": { "node": ">=22" }
}
